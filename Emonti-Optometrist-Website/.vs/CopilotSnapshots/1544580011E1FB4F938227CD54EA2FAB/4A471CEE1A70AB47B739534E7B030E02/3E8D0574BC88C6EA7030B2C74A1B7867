			Response.Redirect("~/Cart.aspx");
		}

		protected void btnLogin_Click(object sender, EventArgs e)
		{
			// Redirect to login page
			Response.Redirect("~/Account/Login.aspx");
		}

		protected void btnRegister_Click(object sender, EventArgs e)
		{
