using System;
using System.Collections.Generic;
using System.Linq;
using System.Web.UI;
using System.Web.UI.HtmlControls;

namespace Emonti_Optometrist_Website
{
	public partial class SiteMaster : MasterPage
	{
		protected void Page_Load(object sender, EventArgs e)
		{
			if (!IsPostBack)
			{
				UpdateCartCount();
				UpdateLoginState();
				HighlightCurrentNav();
			}
		}

		protected override void OnPreRender(EventArgs e)
		{
			base.OnPreRender(e);
			// Update cart count before rendering to catch any changes during the page lifecycle
			UpdateCartCount();
			// Ensure nav highlight is applied in case route changed during lifecycle
			HighlightCurrentNav();
		}

		private void HighlightCurrentNav()
		{
			try
			{
				// Clear any existing active classes
				ClearNavActive(navHome);
				ClearNavActive(navServices);
				ClearNavActive(navShop);
				ClearNavActive(navBook);
				ClearNavActive(navAbout);
				ClearNavActive(navContact);
				ClearNavActive(navHelp);

				string path = (Request.AppRelativeCurrentExecutionFilePath ?? "").ToLowerInvariant();

				if (path.Contains("/default.aspx") || path == "~/")
				{
					SetNavActive(navHome);
				}
				else if (path.Contains("/services.aspx")) SetNavActive(navServices);
				else if (path.Contains("/shop.aspx")) SetNavActive(navShop);
				else if (path.Contains("/appointmentstart.aspx") || path.Contains("/book")) SetNavActive(navBook);
				else if (path.Contains("/about.aspx")) SetNavActive(navAbout);
				else if (path.Contains("/contact.aspx")) SetNavActive(navContact);
				else if (path.Contains("/help.aspx")) SetNavActive(navHelp);
			}
			catch (Exception ex)
			{
				System.Diagnostics.Debug.WriteLine($"HighlightCurrentNav error: {ex.Message}");
			}
		}

		private void SetNavActive(HtmlAnchor anchor)
		{
			if (anchor == null) return;
			string existing = anchor.Attributes["class"] ?? string.Empty;
			if (!existing.Split(' ').Contains("active"))
			{
				anchor.Attributes["class"] = (existing + " active").Trim();
			}
		}

		private void ClearNavActive(HtmlAnchor anchor)
		{
			if (anchor == null) return;
			string existing = anchor.Attributes["class"] ?? string.Empty;
			var cleaned = string.Join(" ", existing.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Where(c => c != "active"));
			anchor.Attributes["class"] = cleaned;
		}

		private void UpdateLoginState()
		{
			// Check if user is logged in using session
			bool isLoggedIn = IsUserLoggedIn();

			// Show/hide login controls based on session state
			if (isLoggedIn)
			{
				// User is logged in - show My Account dropdown, hide login/register and staff portal
				btnLogin.Visible = false;
				btnRegister.Visible = false;
				btnMyAccount.Visible = true;
				btnStaffPortal.Visible = false;
			}
			else
			{
				// User is not logged in - show login, register and staff portal buttons
				btnLogin.Visible = true;
				btnRegister.Visible = true;
				btnMyAccount.Visible = false;
				btnStaffPortal.Visible = true;
			}
		}

		/// <summary>
		/// Helper method to check if user is logged in using session-based authentication
		/// </summary>
		/// <returns>True if user is logged in, false otherwise</returns>
		public bool IsUserLoggedIn()
		{
			return Session["IsLoggedIn"] != null && (bool)Session["IsLoggedIn"];
		}

		/// <summary>
		/// Helper method to get the current user's customer ID from session
		/// </summary>
		/// <returns>Customer ID as string, or null if not logged in</returns>
		public string GetCurrentCustomerId()
		{
			return Session["Cust_ID"]?.ToString();
		}

		/// <summary>
		/// Helper method to get the current user's email from session
		/// </summary>
		/// <returns>User email as string, or null if not logged in</returns>
		public string GetCurrentUserEmail()
		{
			return Session["UserEmail"]?.ToString();
		}

		private void UpdateCartCount()
		{
			int totalItems = 0;
			bool isLoggedIn = IsUserLoggedIn();

			if (isLoggedIn)
			{
				// Use database cart for logged-in users
				string custId = GetCurrentCustomerId();
				if (!string.IsNullOrEmpty(custId))
				{
					try
					{
						int cartId = CartDatabase.GetOrCreateCart(custId);
						totalItems = CartDatabase.GetCartItemCount(cartId);
					}
					catch (Exception ex)
					{
						System.Diagnostics.Debug.WriteLine($"Error getting database cart count: {ex.Message}");
						totalItems = 0;
					}
				}
			}
			else
			{
				// Use session cart for guests
				totalItems = CartTransfer.GetTotalItems(Session.SessionID);
			}

			// Find the cart count span and update it
			var cartCountSpan = btnCart.FindControl("cartCountSpan") as System.Web.UI.HtmlControls.HtmlGenericControl;
			if (cartCountSpan != null)
			{
				cartCountSpan.InnerText = totalItems.ToString();
			}
		}

		private void UpdateWishlistCount()
		{
			if (IsUserLoggedIn())
			{
				string custId = GetCurrentCustomerId();
				if (!string.IsNullOrEmpty(custId))
				{
					try
					{
						int customerId = Convert.ToInt32(custId);
						int wishlistCount = WishlistDatabase.GetWishlistItemCount(customerId);

						// Find the wishlist count span and update it (if it exists)
						var wishlistCountSpan = btnWishlist.FindControl("wishlistCountSpan") as System.Web.UI.HtmlControls.HtmlGenericControl;
						if (wishlistCountSpan != null)
						{
							wishlistCountSpan.InnerText = wishlistCount.ToString();
						}
					}
					catch (Exception ex)
					{
						System.Diagnostics.Debug.WriteLine($"Error getting wishlist count: {ex.Message}");
					}
				}
			}
		}

		/// <summary>
		/// Public method to update cart counter - call this from other pages after cart modifications
		/// </summary>
		public void UpdateCartCounter()
		{
			UpdateCartCount();
		}

