        private string GetCustomerStreetAddress(string custId)
        {
            try
            {
                string connString = System.Configuration.ConfigurationManager.ConnectionStrings["ProductConnection"].ConnectionString;
                using (SqlConnection conn = new SqlConnection(connString))
                {
                    string query = @"
                        SELECT Street_Number, Street_Name, Complex_Name, Unit_Number
                        FROM customer 
                        WHERE Cust_ID = @CustID";
                    
                    using (SqlCommand cmd = new SqlCommand(query, conn))
                    {
                        cmd.Parameters.AddWithValue("@CustID", custId);
                        conn.Open();
                        
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                string streetNumber = reader["Street_Number"]?.ToString() ?? "";
                                string streetName = reader["Street_Name"]?.ToString() ?? "";
                                string complexName = reader["Complex_Name"]?.ToString() ?? "";
                                string unitNumber = reader["Unit_Number"]?.ToString() ?? "";
                                
                                // Build street address
                                string streetAddress = "";
                                if (!string.IsNullOrEmpty(streetNumber) && !string.IsNullOrEmpty(streetName))
                                {
                                    streetAddress = streetNumber + " " + streetName;
                                }
                                else if (!string.IsNullOrEmpty(streetName))
                                {
                                    streetAddress = streetName;
                                }
                                
                                if (!string.IsNullOrEmpty(complexName))
                                {
                                    streetAddress += (string.IsNullOrEmpty(streetAddress) ? "" : ", ") + complexName;
                                }
                                
                                if (!string.IsNullOrEmpty(unitNumber))
                                {
                                    streetAddress += (string.IsNullOrEmpty(streetAddress) ? "" : ", Unit ") + unitNumber;
                                }
                                
                                return streetAddress;
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error getting customer street address: {ex.Message}");
            }
            
            return "";
        }

        private void FinalizeOrderFromPayment(string paymentReference)
        {
            try
            {
                System.Diagnostics.Debug.WriteLine($"FinalizeOrderFromPayment: Payment reference = {paymentReference}");

                // Try to get OrderId from querystring first, then session
                string orderIdStr = Request.QueryString["OrderId"] ?? Request.QueryString["orderId"];
                int orderId = 0;
                if (!string.IsNullOrEmpty(orderIdStr) && int.TryParse(orderIdStr, out int parsedId))
                {
                    orderId = parsedId;
                }
                else if (Session["LastOrderId"] != null)
                {
                    int.TryParse(Session["LastOrderId"].ToString(), out orderId);
                }

                if (orderId == 0)
                {
                    System.Diagnostics.Debug.WriteLine("FinalizeOrderFromPayment Error: No OrderId available (querystring or session)");
                    ShowMessage("Order not found. Please contact support.", false);
                    return;
                }

                // Use DB transaction to finalize payment and update order
                string connString = System.Configuration.ConfigurationManager.ConnectionStrings["ProductConnection"].ConnectionString;
                using (SqlConnection conn = new SqlConnection(connString))
                {
                    conn.Open();
                    using (SqlTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            // Verify payment via Paystack API
                            bool isValid = OrderDatabase.VerifyWithPaystackAPI(paymentReference);

                            if (!isValid)
                            {
                                System.Diagnostics.Debug.WriteLine($"Payment verification failed for reference {paymentReference}");

                                // Mark order/payment as failed
                                OrderDatabase.UpdateOrderStatus(orderId, "Failed");
                                OrderDatabase.UpdatePaymentStatus(orderId, "Failed");

                                transaction.Rollback();
                                ShowMessage("Payment verification failed. Please contact support.", false);
                                return;
                            }

                            // Finalize payment record (marks Payment record as Paid and stores reference & amount)
                            // We don't have the exact amount from Paystack here, so use the Order total
                            var order = OrderDatabase.GetOrder(orderId);
                            decimal amountReceived = order?.Order_Total ?? 0m;

                            OrderDatabase.FinalizePaymentForOrder(orderId, paymentReference, amountReceived, conn, transaction);

                            // Update order and payment status
                            OrderDatabase.UpdateOrderStatus(orderId, "Paid");
                            OrderDatabase.UpdatePaymentStatus(orderId, "Paid", DateTime.Now);

                            // Update inventory now that payment is confirmed
                            OrderDatabase.UpdateInventory(orderId, conn, transaction);

                            // Commit
                            transaction.Commit();

                            // Refresh order object for display and email
                            order = OrderDatabase.GetOrder(orderId);

                            // Ensure LastOrderId in session
                            Session["LastOrderId"] = orderId;

                            // Send confirmation email
                            SendOrderConfirmationEmail(orderId, order);

                            // Optionally redirect to the same page with OrderId to load details
                            Response.Redirect($"OrderConfirmation.aspx?OrderId={orderId}&fromPayment=true", true);
                        }
                        catch (Exception ex)
                        {
                            transaction.Rollback();
                            System.Diagnostics.Debug.WriteLine($"FinalizeOrderFromPayment Error: {ex.Message}");
                            System.Diagnostics.Debug.WriteLine($"Stack Trace: {ex.StackTrace}");
                            ShowMessage("Error finalizing payment. Please contact support.", false);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"FinalizeOrderFromPayment Outer Error: {ex.Message}");
                ShowMessage("Error processing payment confirmation. Please contact support.", false);
            }
        }

        // Replace previous CreateOrderFromPayment usage with finalize method
