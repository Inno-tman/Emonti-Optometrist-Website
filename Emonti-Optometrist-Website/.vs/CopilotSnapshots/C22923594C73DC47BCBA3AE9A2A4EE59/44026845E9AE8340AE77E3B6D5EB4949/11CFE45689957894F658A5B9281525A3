        protected void Page_Load(object sender, EventArgs e)
        {
            if (!IsPostBack)
            {
                // Check if this is a new payment confirmation
                string paymentRef = Request.QueryString["ref"];
                if (!string.IsNullOrEmpty(paymentRef))
                {
                    // Create order from payment confirmation
                    CreateOrderFromPayment(paymentRef);
                }
                
                // Load order details
                LoadOrderDetails();
            }
        }

        private void LoadOrderDetails()
        {
            try
            {
                // Get order ID from query string
                string orderIdStr = Request.QueryString["OrderId"];
                
                if (string.IsNullOrEmpty(orderIdStr) || !int.TryParse(orderIdStr, out int orderId))
                {
                    ShowMessage("Invalid order ID. Please contact support if this issue persists.", false);
                    return;
                }

                // Load order details from database
                var order = OrderDatabase.GetOrder(orderId);
                if (order == null)
                {
                    ShowMessage("Order not found. Please contact support.", false);
                    return;
                }

                // Display order information
                litOrderNumber.Text = order.Order_Number;
                litOrderDate.Text = order.Order_Date.ToString("MMMM dd, yyyy");

                // Load order items
                var orderItems = OrderDatabase.GetOrderItems(orderId);
                if (orderItems != null && orderItems.Count > 0)
                {
                    // Bind order items to repeater
                    rptOrderItems.DataSource = orderItems;
                    rptOrderItems.DataBind();
                    
                    // Display order totals
                    decimal subtotal = orderItems.Sum(x => x.Subtotal);
                    decimal shipping = 150.00m; // Fixed shipping cost
                    decimal total = order.Order_Total;

                    // Update literals with real data
                    litSubtotal.Text = subtotal.ToString("F2");
                    litShipping.Text = shipping.ToString("F2");
                    litTotal.Text = total.ToString("F2");
                }

                // Display shipping information
                litShippingAddress.Text = order.Delivery_Address.Replace("\n", "<br>");
                litPaymentMethod.Text = GetPaymentMethodDisplay(order.Payment_Method);

                // Note: Email is sent in CreateOrderFromPayment after order creation
                // This prevents duplicate emails when user refreshes the confirmation page
                // Note: Inventory levels are updated in CreateOrderFromPayment after order items are added
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine($"Error loading order details: {ex.Message}");
                ShowMessage("Error loading order details. Please contact support.", false);
            }
        }

