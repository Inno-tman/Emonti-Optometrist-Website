@page
@model ProfileModel
@{
    ViewData["Title"] = "My Profile";
}

@section HeadContent {
    <style>
        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --text-dark: #2c3e50;
            --text-muted: #666;
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .profile-hero {
            background: linear-gradient(-45deg, var(--primary), var(--secondary), var(--primary), var(--secondary));
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            color: white;
            padding: 7rem 1.5rem 3rem;
            text-align: center;
        }

        .profile-hero h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .profile-hero p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        .profile-section {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.25rem;
            animation: fadeInUp 0.6s ease;
        }

        .dashboard-card {
            background: white;
            border-radius: 14px;
            padding: 1.75rem;
            box-shadow: 0 4px 16px rgba(0,0,0,0.08);
            border: 1px solid rgba(102, 126, 234, 0.1);
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            color: var(--text-dark);
        }

        .dashboard-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 32px rgba(102, 126, 234, 0.18);
            border-color: rgba(102, 126, 234, 0.3);
        }

        .card-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            flex-shrink: 0;
        }

        .card-content h3 {
            margin: 0 0 0.25rem;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .card-content p {
            margin: 0;
            font-size: 0.9rem;
            color: var(--text-muted);
        }

        @@media (min-width: 600px) {
            .dashboard-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (min-width: 900px) {
            .dashboard-grid {
                grid-template-columns: 1fr 1fr 1fr;
            }
            .dashboard-card:last-child:nth-child(odd) {
                grid-column: 2;
            }
        }
    </style>
}

<section class="profile-hero">
    <h1>Welcome, @Model.WelcomeName</h1>
    <p>Manage your account and preferences</p>
</section>

<section class="profile-section">
    <div class="dashboard-grid">
        <a href="/PersonalDetails" class="dashboard-card">
            <div class="card-icon"><i class="fas fa-user"></i></div>
            <div class="card-content">
                <h3>Personal Details</h3>
                <p>View and update your personal information</p>
            </div>
        </a>
        <a href="/Wishlist" class="dashboard-card">
            <div class="card-icon"><i class="fas fa-heart"></i></div>
            <div class="card-content">
                <h3>Wishlist</h3>
                <p>Items you've saved for later</p>
            </div>
        </a>
        <a href="/Cart" class="dashboard-card">
            <div class="card-icon"><i class="fas fa-shopping-cart"></i></div>
            <div class="card-content">
                <h3>Shopping Cart</h3>
                <p>Review items before checkout</p>
            </div>
        </a>
        <a href="/BookAppointment" class="dashboard-card">
            <div class="card-icon"><i class="fas fa-calendar-check"></i></div>
            <div class="card-content">
                <h3>Book Appointment</h3>
                <p>Schedule an eye care visit</p>
            </div>
        </a>
    </div>
</section>
