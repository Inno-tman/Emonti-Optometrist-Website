@page
@model ManageStaffModel
@{
    ViewData["Title"] = "Manage Staff";
}

@section HeadContent {
    <style>
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }

        .admin-wrapper { display: flex; min-height: 100vh; }

        .admin-sidebar {
            width: 250px; background: #1a1d23; color: #fff;
            padding: 1.5rem 0; flex-shrink: 0;
            position: fixed; top: 0; left: 0; height: 100vh; overflow-y: auto;
            z-index: 100;
        }
        .sidebar-brand { padding: 0 1.25rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 1rem; }
        .sidebar-brand h2 { font-size: 1.1rem; font-weight: 700; color: #fff; }
        .sidebar-brand small { font-size: 0.75rem; color: rgba(255,255,255,0.5); }
        .sidebar-nav { list-style: none; padding: 0; }
        .sidebar-nav li a {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.75rem 1.25rem; color: rgba(255,255,255,0.65);
            text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.2s ease; border-left: 3px solid transparent;
        }
        .sidebar-nav li a:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar-nav li a.active { background: rgba(102,126,234,0.15); color: #667eea; border-left-color: #667eea; }
        .sidebar-nav li a i { width: 20px; text-align: center; }

        .admin-main { margin-left: 250px; flex: 1; padding: 2rem; min-height: 100vh; }

        .admin-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;
        }
        .admin-header h1 { font-size: 1.5rem; font-weight: 700; color: #1a1d23; }
        .admin-header h1 i { color: #667eea; margin-right: 0.5rem; }

        .alert {
            padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem;
            font-size: 0.85rem; font-weight: 500; animation: slideDown 0.3s ease;
        }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }

        .section-card {
            background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            overflow: hidden; margin-bottom: 1.5rem; animation: fadeInUp 0.5s ease-out;
        }
        .section-header {
            padding: 1rem 1.25rem; border-bottom: 1px solid #f0f0f0;
            display: flex; align-items: center; justify-content: space-between;
        }
        .section-header h2 { font-size: 1rem; font-weight: 700; color: #1a1d23; display: flex; align-items: center; gap: 0.5rem; }
        .section-header h2 i { color: #667eea; }

        table { width: 100%; border-collapse: collapse; }
        thead { background: #f8f9fa; }
        th { padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #888; }
        td { padding: 0.7rem 1rem; font-size: 0.85rem; color: #333; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
        tr:hover td { background: rgba(102,126,234,0.02); }

        .role-badge {
            display: inline-block; padding: 0.15rem 0.5rem; border-radius: 12px;
            font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px;
        }
        .role-badge.admin { background: #e9d8fd; color: #6b46c1; }
        .role-badge.staff { background: #cce5ff; color: #004085; }
        .role-badge.optometrist { background: #d4edda; color: #155724; }

        .btn {
            display: inline-flex; align-items: center; gap: 0.35rem;
            padding: 0.35rem 0.75rem; border: none; border-radius: 6px;
            font-weight: 600; font-size: 0.8rem; cursor: pointer; text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-sm { font-size: 0.75rem; padding: 0.3rem 0.6rem; }
        .btn-danger { background: #fc8181; color: #fff; }
        .btn-danger:hover { background: #f56565; }
        .btn-success { background: #68d391; color: #fff; }
        .btn-success:hover { background: #48bb78; }
        .btn-primary { background: #667eea; color: #fff; }
        .btn-primary:hover { background: #5a67d8; }
        .btn-warning { background: #f6ad55; color: #fff; }
        .btn-warning:hover { background: #ed8936; }

        .add-staff-form {
            display: flex; gap: 0.5rem; padding: 1rem 1.25rem;
            align-items: center; flex-wrap: wrap;
        }
        .add-staff-form select {
            flex: 1; min-width: 200px; padding: 0.5rem 0.75rem;
            border: 1px solid #ddd; border-radius: 8px; font-size: 0.85rem; font-family: inherit;
        }

        .empty-state { text-align: center; padding: 2rem 1rem; color: #999; }
        .empty-state i { font-size: 2rem; margin-bottom: 0.5rem; color: #ddd; }

        .admin-footer { text-align: center; padding: 1.5rem; color: #999; font-size: 0.8rem; margin-top: 2rem; }

        @@media (max-width: 768px) {
            .admin-sidebar { width: 60px; }
            .sidebar-brand h2, .sidebar-brand small, .sidebar-nav li a span { display: none; }
            .sidebar-nav li a { justify-content: center; padding: 0.75rem; }
            .admin-main { margin-left: 60px; padding: 1rem; }
            .add-staff-form { flex-direction: column; align-items: stretch; }
            .add-staff-form select { min-width: auto; }
        }
    </style>
}

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <h2>EMONTI</h2>
            <small>Admin Panel</small>
        </div>
        <ul class="sidebar-nav">
            <li><a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a></li>
            <li><a href="/Admin/ManageOrders"><i class="fas fa-shopping-cart"></i><span>Orders</span></a></li>
            <li><a href="/Admin/ManageProducts"><i class="fas fa-box"></i><span>Products</span></a></li>
            <li><a href="/Admin/ManageCustomers"><i class="fas fa-address-book"></i><span>Customers</span></a></li>
            <li><a href="/Admin/ManageStaff" class="active"><i class="fas fa-users"></i><span>Staff</span></a></li>
            <li><a href="/Reports"><i class="fas fa-chart-bar"></i><span>Reports</span></a></li>
            <li style="margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.5rem;">
                <a href="/"><i class="fas fa-arrow-left"></i><span>Back to Site</span></a>
            </li>
        </ul>
    </aside>

    <main class="admin-main">
        <div class="admin-header">
            <h1><i class="fas fa-users"></i> Manage Staff</h1>
        </div>

        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success">@successMsg</div>
        }

        <div class="section-card">
            <div class="section-header">
                <h2><i class="fas fa-user-tie"></i> Current Staff</h2>
                <span style="font-size:0.85rem;color:#888;font-weight:500;">@Model.StaffUsers.Count staff member@(Model.StaffUsers.Count != 1 ? "s" : "")</span>
            </div>
            @if (Model.StaffUsers.Count > 0)
            {
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in Model.StaffUsers)
                        {
                            <tr>
                                <td><strong>@staff.Name @staff.Surname</strong></td>
                                <td>@staff.Email</td>
                                <td>
                                    @if (staff.IsAdmin)
                                    {
                                        <span class="role-badge admin">Admin</span>
                                    }
                                    else if (staff.Role == "Optometrist")
                                    {
                                        <span class="role-badge optometrist">Optometrist</span>
                                    }
                                    else
                                    {
                                        <span class="role-badge staff">Staff</span>
                                    }
                                </td>
                                <td>
                                    @if (!staff.IsAdmin)
                                    {
                                        <form method="post" asp-page-handler="MakeAdmin" style="display:inline;">
                                            <input type="hidden" name="staffId" value="@staff.StaffId" />
                                            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Promote @staff.Email to admin?');">
                                                <i class="fas fa-crown"></i> Make Admin
                                            </button>
                                        </form>
                                    }
                                    @if (!staff.IsAdmin)
                                    {
                                        <form method="post" asp-page-handler="RemoveStaff" style="display:inline;" onsubmit="return confirm('Remove @staff.Email from staff?');">
                                            <input type="hidden" name="staffId" value="@staff.StaffId" />
                                            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-user-minus"></i> Remove</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-users"></i>
                    <p>No staff members yet.</p>
                </div>
            }
        </div>

        <div class="section-card">
            <div class="section-header">
                <h2><i class="fas fa-user-plus"></i> Add Staff Member</h2>
            </div>
            <form method="post" asp-page-handler="AddStaff" class="add-staff-form" style="display:flex;flex-direction:column;gap:0.75rem;padding:1rem 1.25rem;">
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0.75rem;">
                    <input type="text" name="staffName" placeholder="First Name" required style="padding:0.5rem 0.75rem;border:1px solid #ddd;border-radius:8px;font-size:0.85rem;font-family:inherit;" />
                    <input type="text" name="staffSurname" placeholder="Surname" style="padding:0.5rem 0.75rem;border:1px solid #ddd;border-radius:8px;font-size:0.85rem;font-family:inherit;" />
                    <input type="email" name="staffEmail" placeholder="Email Address" required style="padding:0.5rem 0.75rem;border:1px solid #ddd;border-radius:8px;font-size:0.85rem;font-family:inherit;" />
                    <input type="password" name="staffPassword" placeholder="Password (default: Staff123)" style="padding:0.5rem 0.75rem;border:1px solid #ddd;border-radius:8px;font-size:0.85rem;font-family:inherit;" />
                    <select name="staffRole" style="padding:0.5rem 0.75rem;border:1px solid #ddd;border-radius:8px;font-size:0.85rem;font-family:inherit;">
                        <option value="Staff">Staff</option>
                        <option value="Admin">Admin</option>
                        <option value="Optometrist">Optometrist</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success" style="align-self:flex-start;"><i class="fas fa-plus"></i> Add Staff</button>
            </form>
        </div>

        <div class="admin-footer">
            &copy; @DateTime.Now.Year Emonti Optometrist Admin Panel
        </div>
    </main>
</div>
