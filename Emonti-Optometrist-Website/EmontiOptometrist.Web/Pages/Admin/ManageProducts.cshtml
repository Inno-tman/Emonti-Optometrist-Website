@page
@model ManageProductsModel
@{
    ViewData["Title"] = "Manage Products";
}

@section HeadContent {
    <style>
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: #f0f2f5; }

        .admin-wrapper { display: flex; min-height: 100vh; }

        .admin-sidebar {
            width: 250px; background: #1a1d23; color: #fff;
            padding: 1.5rem 0; flex-shrink: 0;
            position: fixed; top: 0; left: 0; height: 100vh; overflow-y: auto;
            z-index: 100;
        }
        .sidebar-brand { padding: 0 1.25rem 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); margin-bottom: 1rem; }
        .sidebar-brand h2 { font-size: 1.1rem; font-weight: 700; color: #fff; }
        .sidebar-brand small { font-size: 0.75rem; color: rgba(255,255,255,0.5); }
        .sidebar-nav { list-style: none; padding: 0; }
        .sidebar-nav li a {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.75rem 1.25rem; color: rgba(255,255,255,0.65);
            text-decoration: none; font-size: 0.9rem; font-weight: 500;
            transition: all 0.2s ease; border-left: 3px solid transparent;
        }
        .sidebar-nav li a:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar-nav li a.active { background: rgba(102,126,234,0.15); color: #667eea; border-left-color: #667eea; }
        .sidebar-nav li a i { width: 20px; text-align: center; }

        .admin-main { margin-left: 250px; flex: 1; padding: 2rem; min-height: 100vh; }

        .admin-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;
        }
        .admin-header h1 { font-size: 1.5rem; font-weight: 700; color: #1a1d23; }
        .admin-header h1 i { color: #667eea; margin-right: 0.5rem; }

        .alert {
            padding: 0.75rem 1rem; border-radius: 8px; margin-bottom: 1rem;
            font-size: 0.85rem; font-weight: 500; animation: slideDown 0.3s ease;
        }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }

        .action-bar {
            display: flex; gap: 0.75rem; margin-bottom: 1.5rem; flex-wrap: wrap;
        }
        .btn {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.5rem 1rem; border: none; border-radius: 8px;
            font-weight: 600; font-size: 0.85rem; cursor: pointer; text-decoration: none;
            transition: all 0.2s ease;
        }
        .btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
        .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(102,126,234,0.3); color: #fff; }
        .btn-sm { padding: 0.3rem 0.65rem; font-size: 0.8rem; }
        .btn-edit { background: #e2e8f0; color: #2d3748; }
        .btn-edit:hover { background: #cbd5e0; }
        .btn-danger { background: #fc8181; color: #fff; }
        .btn-danger:hover { background: #f56565; }
        .btn-success { background: #68d391; color: #fff; }
        .btn-success:hover { background: #48bb78; }

        .table-card {
            background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            overflow: hidden; animation: fadeInUp 0.5s ease-out;
        }
        table { width: 100%; border-collapse: collapse; }
        thead { background: #f8f9fa; }
        th { padding: 0.75rem 1rem; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #888; }
        td { padding: 0.7rem 1rem; font-size: 0.85rem; color: #333; border-bottom: 1px solid #f5f5f5; vertical-align: middle; }
        tr:hover td { background: rgba(102,126,234,0.02); }

        .stock-low { color: #e53e3e; font-weight: 600; }
        .stock-ok { color: #38a169; }

        .empty-state { text-align: center; padding: 3rem 1rem; color: #999; }
        .empty-state i { font-size: 2.5rem; margin-bottom: 0.75rem; color: #ddd; }

        .admin-footer { text-align: center; padding: 1.5rem; color: #999; font-size: 0.8rem; margin-top: 2rem; }

        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;
            animation: fadeInUp 0.2s ease;
        }
        .modal-overlay.show { display: flex; }
        .modal {
            background: #fff; border-radius: 12px; padding: 1.5rem; width: 90%; max-width: 500px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2); max-height: 80vh; overflow-y: auto;
        }
        .modal h3 { font-size: 1.15rem; font-weight: 700; color: #1a1d23; margin-bottom: 1.25rem; }
        .modal .form-group { margin-bottom: 0.75rem; }
        .modal .form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 0.25rem; }
        .modal .form-group input, .modal .form-group select {
            width: 100%; padding: 0.5rem 0.75rem; border: 1px solid #ddd; border-radius: 8px;
            font-size: 0.85rem; font-family: inherit;
        }
        .modal .modal-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; justify-content: flex-end; }
        .modal .btn-cancel { background: #e2e8f0; color: #2d3748; }

        @@media (max-width: 768px) {
            .admin-sidebar { width: 60px; }
            .sidebar-brand h2, .sidebar-brand small, .sidebar-nav li a span { display: none; }
            .sidebar-nav li a { justify-content: center; padding: 0.75rem; }
            .admin-main { margin-left: 60px; padding: 1rem; }
        }
    </style>
}

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <h2>EMONTI</h2>
            <small>Admin Panel</small>
        </div>
        <ul class="sidebar-nav">
            <li><a href="/Admin/Dashboard"><i class="fas fa-tachometer-alt"></i><span>Dashboard</span></a></li>
            <li><a href="/Admin/ManageOrders"><i class="fas fa-shopping-cart"></i><span>Orders</span></a></li>
            <li><a href="/Admin/ManageProducts" class="active"><i class="fas fa-box"></i><span>Products</span></a></li>
            <li><a href="/Admin/ManageStaff"><i class="fas fa-users"></i><span>Staff</span></a></li>
            <li><a href="/Reports"><i class="fas fa-chart-bar"></i><span>Reports</span></a></li>
            <li style="margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 0.5rem;">
                <a href="/"><i class="fas fa-arrow-left"></i><span>Back to Site</span></a>
            </li>
        </ul>
    </aside>

    <main class="admin-main">
        <div class="admin-header">
            <h1><i class="fas fa-box"></i> Manage Products</h1>
        </div>

        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <div class="alert alert-success">@successMsg</div>
        }

        <div class="action-bar">
            <button class="btn btn-primary" onclick="showModal('addModal')"><i class="fas fa-plus"></i> Add Product</button>
        </div>

        <div class="table-card">
            @if (Model.Products.Count > 0)
            {
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Brand</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td><strong>@product.Name</strong></td>
                                <td>@product.Brand</td>
                                <td>@product.Category</td>
                                <td>R @product.Price.ToString("N2")</td>
                                <td class="@(product.Stock < 5 ? "stock-low" : "stock-ok")">@product.Stock</td>
                                <td>
                                    <button class="btn btn-sm btn-edit" onclick="editProduct(@product.ProductId, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(product.Name)', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(product.Brand)', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(product.Category)', '@product.Price.ToString("F2")', '@product.Stock')">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Delete @System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(product.Name)?');">
                                        <input type="hidden" name="id" value="@product.ProductId" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="fas fa-box-open"></i>
                    <p>No products found.</p>
                </div>
            }
        </div>

        <div class="admin-footer">
            &copy; @DateTime.Now.Year Emonti Optometrist Admin Panel
        </div>
    </main>
</div>

<!-- Add Product Modal -->
<div id="addModal" class="modal-overlay">
    <div class="modal">
        <h3><i class="fas fa-plus" style="color:#667eea;"></i> Add Product</h3>
        <form method="post" asp-page-handler="Add">
            <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="NewProduct.Name" required />
            </div>
            <div class="form-group">
                <label>Brand</label>
                <input type="text" name="NewProduct.Brand" list="brands" />
                <datalist id="brands">
                    @foreach (var b in Model.Brands) { <option value="@b" /> }
                </datalist>
            </div>
            <div class="form-group">
                <label>Category</label>
                <input type="text" name="NewProduct.Category" list="categories" />
                <datalist id="categories">
                    @foreach (var c in Model.Categories) { <option value="@c" /> }
                </datalist>
            </div>
            <div class="form-group">
                <label>Price (R)</label>
                <input type="number" step="0.01" min="0" name="NewProduct.Price" required />
            </div>
            <div class="form-group">
                <label>Stock</label>
                <input type="number" min="0" name="NewProduct.Stock" required />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-cancel" onclick="hideModal('addModal')">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Add</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Product Modal -->
<div id="editModal" class="modal-overlay">
    <div class="modal">
        <h3><i class="fas fa-edit" style="color:#667eea;"></i> Edit Product</h3>
        <form method="post" asp-page-handler="Edit">
            <input type="hidden" name="EditProduct.Id" id="editId" />
            <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="EditProduct.Name" id="editName" required />
            </div>
            <div class="form-group">
                <label>Brand</label>
                <input type="text" name="EditProduct.Brand" id="editBrand" list="brands" />
            </div>
            <div class="form-group">
                <label>Category</label>
                <input type="text" name="EditProduct.Category" id="editCategory" list="categories" />
            </div>
            <div class="form-group">
                <label>Price (R)</label>
                <input type="number" step="0.01" min="0" name="EditProduct.Price" id="editPrice" required />
            </div>
            <div class="form-group">
                <label>Stock</label>
                <input type="number" min="0" name="EditProduct.Stock" id="editStock" required />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-cancel" onclick="hideModal('editModal')">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save</button>
            </div>
        </form>
    </div>
</div>

<script>
    function showModal(id) { document.getElementById(id).classList.add('show'); }
    function hideModal(id) { document.getElementById(id).classList.remove('show'); }

    function editProduct(id, name, brand, category, price, stock) {
        document.getElementById('editId').value = id;
        document.getElementById('editName').value = name;
        document.getElementById('editBrand').value = brand;
        document.getElementById('editCategory').value = category;
        document.getElementById('editPrice').value = price;
        document.getElementById('editStock').value = stock;
        showModal('editModal');
    }

    document.querySelectorAll('.modal-overlay').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target === el) el.classList.remove('show');
        });
    });
</script>
