<script>
    function openBenefitsModal() {
        document.getElementById('benefitsModal').classList.add('show');
    }

    function closeBenefitsModal() {
        document.getElementById('benefitsModal').classList.remove('show');
    }

    // Close modal on outside click
    document.addEventListener('DOMContentLoaded', function() {
        var modal = document.getElementById('benefitsModal');
        if (modal) {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeBenefitsModal();
                }
            });
        }
    });

    // Wait for page to load
    window.addEventListener('DOMContentLoaded', function () {
        // ===== THREE.JS SERVICES SECTION PARTICLES =====
        if (typeof THREE !== 'undefined' && window.innerWidth > 480) {
            const servicesSection = document.querySelector('.services-section');

            if (servicesSection) {
                const servicesCanvas = document.createElement('canvas');
                servicesCanvas.style.position = 'absolute';
                servicesCanvas.style.top = '0';
                servicesCanvas.style.left = '0';
                servicesCanvas.style.width = '100%';
                servicesCanvas.style.height = '100%';
                servicesCanvas.style.zIndex = '0';
                servicesCanvas.style.pointerEvents = 'none';
                servicesSection.style.position = 'relative';
                servicesSection.insertBefore(servicesCanvas, servicesSection.firstChild);

                const servicesScene = new THREE.Scene();
                const servicesCamera = new THREE.PerspectiveCamera(75, servicesSection.offsetWidth / servicesSection.offsetHeight, 0.1, 1000);
                const servicesRenderer = new THREE.WebGLRenderer({ canvas: servicesCanvas, alpha: true, antialias: true });
                servicesRenderer.setSize(servicesSection.offsetWidth, servicesSection.offsetHeight);
                servicesRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

                let servicesParticlesCount = 300;
                if (window.innerWidth <= 768) {
                    servicesParticlesCount = 150;
                }

                const servicesParticlesGeometry = new THREE.BufferGeometry();
                const servicesPositions = new Float32Array(servicesParticlesCount * 3);
                const servicesColors = new Float32Array(servicesParticlesCount * 3);

                for (let i = 0; i < servicesParticlesCount * 3; i += 3) {
                    servicesPositions[i] = (Math.random() - 0.5) * 15;
                    servicesPositions[i + 1] = (Math.random() - 0.5) * 15;
                    servicesPositions[i + 2] = (Math.random() - 0.5) * 8;

                    servicesColors[i] = 0.4 + Math.random() * 0.2;
                    servicesColors[i + 1] = 0.3 + Math.random() * 0.2;
                    servicesColors[i + 2] = 0.9 + Math.random() * 0.1;
                }

                servicesParticlesGeometry.setAttribute('position', new THREE.BufferAttribute(servicesPositions, 3));
                servicesParticlesGeometry.setAttribute('color', new THREE.BufferAttribute(servicesColors, 3));

                const servicesParticlesMaterial = new THREE.PointsMaterial({
                    size: 0.03,
                    vertexColors: true,
                    transparent: true,
                    opacity: 0.5,
                    blending: THREE.AdditiveBlending
                });

                const servicesParticlesMesh = new THREE.Points(servicesParticlesGeometry, servicesParticlesMaterial);
                servicesScene.add(servicesParticlesMesh);

                servicesCamera.position.z = 5;

                const servicesClock = new THREE.Clock();
                function animateServices() {
                    requestAnimationFrame(animateServices);
                    const elapsed = servicesClock.getElapsedTime();
                    servicesParticlesMesh.rotation.y = elapsed * 0.02;
                    servicesParticlesMesh.rotation.x = elapsed * 0.01;
                    servicesRenderer.render(servicesScene, servicesCamera);
                }

                animateServices();

                window.addEventListener('resize', function () {
                    servicesCamera.aspect = servicesSection.offsetWidth / servicesSection.offsetHeight;
                    servicesCamera.updateProjectionMatrix();
                    servicesRenderer.setSize(servicesSection.offsetWidth, servicesSection.offsetHeight);
                });
            }
        }

        // ===== CURSOR TRAIL EFFECT =====
        let cursorTrailTimeout;
        document.addEventListener('mousemove', function (e) {
            clearTimeout(cursorTrailTimeout);
            cursorTrailTimeout = setTimeout(function () {
                const trail = document.createElement('div');
                trail.className = 'cursor-trail';
                trail.style.left = e.pageX + 'px';
                trail.style.top = e.pageY + 'px';
                document.body.appendChild(trail);

                setTimeout(function () {
                    trail.remove();
                }, 1000);
            }, 50);
        });

        // ===== PARALLAX SCROLLING =====
        window.addEventListener('scroll', function () {
            const scrolled = window.pageYOffset;
            const parallaxShapes = document.querySelectorAll('.parallax-shape');

            parallaxShapes.forEach(function (shape, index) {
                const speed = 0.5 + (index * 0.2);
                const yPos = -(scrolled * speed);
                shape.style.transform = 'translateY(' + yPos + 'px)';
            });
        });

        // ===== SCROLL REVEAL ANIMATION =====
        const serviceCards = document.querySelectorAll('.service-card');

        function revealOnScroll() {
            const windowHeight = window.innerHeight;
            const revealPoint = 100;

            serviceCards.forEach(function (card, index) {
                const cardTop = card.getBoundingClientRect().top;
                if (cardTop < windowHeight - revealPoint) {
                    setTimeout(function () {
                        card.classList.add('active');
                    }, index * 150);
                }
            });
        }

        revealOnScroll();
        window.addEventListener('scroll', revealOnScroll);

        // ===== MEDICAL AID AUTOSCROLL INITIALIZATION =====
        const medicalAidTrack = document.getElementById('medicalAidTrack');
        if (medicalAidTrack) {
            const medicalAidImages = medicalAidTrack.querySelectorAll('img');
            let imagesLoaded = 0;
            const totalImages = medicalAidImages.length;

            function initializeMedicalAidScroll() {
                const trackWidth = medicalAidTrack.scrollWidth;
                medicalAidTrack.style.width = trackWidth + 'px';
                medicalAidTrack.classList.add('animate');
            }

            if (totalImages === 0) {
                setTimeout(initializeMedicalAidScroll, 100);
            } else {
                medicalAidImages.forEach(function(img) {
                    if (img.complete) {
                        imagesLoaded++;
                    } else {
                        img.addEventListener('load', function() {
                            imagesLoaded++;
                            if (imagesLoaded === totalImages) {
                                setTimeout(initializeMedicalAidScroll, 500);
                            }
                        });
                        img.addEventListener('error', function() {
                            imagesLoaded++;
                            if (imagesLoaded === totalImages) {
                                setTimeout(initializeMedicalAidScroll, 500);
                            }
                        });
                    }
                });
                if (imagesLoaded === totalImages) {
                    setTimeout(initializeMedicalAidScroll, 500);
                }
            }
        }
    });
</script>