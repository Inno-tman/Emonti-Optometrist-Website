@page
@model CartModel
@{
    ViewData["Title"] = "Shopping Cart";
}

@section HeadContent {
    <style>
        :root {
            --primary: #667eea;
            --secondary: #764ba2;
            --bg-light: #f8f9fa;
            --text-dark: #2c3e50;
            --text-muted: #666;
            --danger: #e74c3c;
            --success: #27ae60;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .cart-hero {
            background: linear-gradient(-45deg, var(--primary), var(--secondary), var(--primary), var(--secondary));
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
            color: white;
            padding: 7rem 1.5rem 3rem;
            text-align: center;
        }

        .cart-hero h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .cart-hero p {
            font-size: 1.1rem;
            opacity: 0.9;
            max-width: 500px;
            margin: 0 auto;
        }

        .cart-section {
            max-width: 1000px;
            margin: 2rem auto;
            padding: 0 1.5rem;
        }

        .cart-empty {
            text-align: center;
            padding: 4rem 1.5rem;
            animation: fadeIn 0.5s ease;
        }

        .cart-empty i {
            font-size: 4rem;
            color: var(--primary);
            opacity: 0.5;
            margin-bottom: 1.5rem;
        }

        .cart-empty h2 {
            font-size: 1.75rem;
            color: var(--text-dark);
            margin-bottom: 0.75rem;
        }

        .cart-empty p {
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        .btn-shop-now {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 0.9rem 2rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-shop-now:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .cart-table {
            width: 100%;
            border-collapse: collapse;
            animation: fadeIn 0.5s ease;
        }

        .cart-table thead {
            display: none;
        }

        .cart-item-row {
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            margin-bottom: 1rem;
            padding: 1rem;
            gap: 0.75rem;
            border: 1px solid rgba(102, 126, 234, 0.1);
            transition: box-shadow 0.3s ease;
        }

        .cart-item-row:hover {
            box-shadow: 0 4px 20px rgba(102, 126, 234, 0.15);
        }

        .cart-item-top {
            display: flex;
            gap: 1rem;
            align-items: flex-start;
        }

        .cart-item-image {
            width: 90px;
            height: 90px;
            border-radius: 10px;
            object-fit: cover;
            flex-shrink: 0;
            background: var(--bg-light);
        }

        .cart-item-details {
            flex: 1;
            min-width: 0;
        }

        .cart-item-name {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-dark);
            margin: 0 0 0.25rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .cart-item-brand {
            font-size: 0.85rem;
            color: var(--primary);
            font-weight: 500;
            margin: 0 0 0.25rem;
        }

        .cart-item-price {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin: 0;
        }

        .cart-item-controls {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px solid #f0f0f0;
        }

        .qty-controls {
            display: inline-flex;
            align-items: center;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            overflow: hidden;
        }

        .qty-btn {
            background: var(--bg-light);
            border: none;
            width: 36px;
            height: 36px;
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-dark);
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
        }

        .qty-btn:hover {
            background: var(--primary);
            color: white;
        }

        .qty-value {
            width: 40px;
            text-align: center;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--text-dark);
        }

        .cart-item-subtotal {
            font-weight: 700;
            font-size: 1.05rem;
            color: var(--text-dark);
            white-space: nowrap;
        }

        .btn-remove {
            background: none;
            border: none;
            color: var(--danger);
            font-size: 1.2rem;
            cursor: pointer;
            padding: 0.3rem;
            transition: transform 0.2s;
            line-height: 1;
        }

        .btn-remove:hover {
            transform: scale(1.2);
        }

        .cart-summary {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            padding: 1.5rem;
            margin-top: 1rem;
            border: 1px solid rgba(102, 126, 234, 0.1);
            animation: fadeIn 0.5s ease;
        }

        .cart-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 0;
        }

        .cart-summary-row.total {
            border-top: 2px solid #f0f0f0;
            margin-top: 0.5rem;
            padding-top: 1rem;
        }

        .cart-summary-label {
            font-size: 1rem;
            color: var(--text-muted);
        }

        .cart-summary-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .cart-summary-row.total .cart-summary-value {
            font-size: 1.35rem;
            color: var(--primary);
        }

        .btn-checkout {
            display: block;
            width: 100%;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 1rem;
            border: none;
            border-radius: 10px;
            font-size: 1.1rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            margin-top: 1.25rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .btn-checkout:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
            color: white;
        }

        .btn-checkout i {
            margin-right: 0.5rem;
        }

        .message {
            padding: 0.75rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-size: 0.9rem;
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        @@media (min-width: 768px) {
            .cart-section {
                padding: 0 2rem;
            }

            .cart-table thead {
                display: table-header-group;
            }

            .cart-table thead th {
                padding: 0.75rem 1rem;
                text-align: left;
                font-size: 0.85rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
                background: var(--bg-light);
                border-radius: 8px;
            }

            .cart-table tbody {
                display: table-row-group;
            }

            .cart-item-row {
                display: table-row;
                background: none;
                border-radius: 0;
                box-shadow: none;
                margin-bottom: 0;
                padding: 0;
                border: none;
            }

            .cart-item-row > * {
                display: table-cell;
                vertical-align: middle;
                padding: 1rem 0.5rem;
                border-bottom: 1px solid #f0f0f0;
            }

            .cart-item-top {
                display: table-cell;
                vertical-align: middle;
                padding: 1rem 0.5rem;
                border-bottom: 1px solid #f0f0f0;
            }

            .cart-item-image {
                width: 70px;
                height: 70px;
            }

            .cart-item-details {
                padding: 1rem 0.5rem;
                border-bottom: 1px solid #f0f0f0;
            }

            .cart-item-controls {
                display: table-cell;
                vertical-align: middle;
                padding: 1rem 0.5rem;
                border-bottom: 1px solid #f0f0f0;
            }

            .cart-item-name {
                font-size: 1.05rem;
            }

            .qty-btn {
                width: 32px;
                height: 32px;
                font-size: 1rem;
            }

            .qty-value {
                width: 36px;
            }

            .cart-summary {
                margin-left: auto;
                max-width: 380px;
            }
        }

        @@media (min-width: 1024px) {
            .cart-section {
                padding: 0;
            }
        }
    </style>
}

<section class="cart-hero">
    <h1>Shopping Cart</h1>
    <p>Review and manage your items before checkout</p>
</section>

<section class="cart-section">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="message">@Model.Message</div>
    }

    @if (Model.CartItems.Count == 0)
    {
        <div class="cart-empty">
            <i class="fas fa-shopping-cart"></i>
            <h2>Your cart is empty</h2>
            <p>Looks like you haven't added anything yet. Browse our collection and find your perfect pair!</p>
            <a href="/Shop" class="btn-shop-now">
                <i class="fas fa-arrow-left"></i> Continue Shopping
            </a>
        </div>
    }
    else
    {
        <table class="cart-table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr class="cart-item-row">
                        <td class="cart-item-top">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/Images/Products/default.png" : item.ImageUrl)"
                                 alt="@item.ProductName"
                                 class="cart-item-image"
                                 loading="lazy"
                                 onerror="this.src='/Images/Products/default.png'" />
                            <div class="cart-item-details">
                                <p class="cart-item-name">@item.ProductName</p>
                                <p class="cart-item-brand">@item.Brand</p>
                            </div>
                        </td>
                        <td class="cart-item-details">
                            <p class="cart-item-price">R @item.Price.ToString("N2")</p>
                        </td>
                        <td class="cart-item-controls">
                            <div class="qty-controls">
                                <form method="post" asp-page-handler="UpdateQuantity" style="display:contents">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                            class="qty-btn" @(item.Quantity <= 1 ? "disabled" : "")>&minus;</button>
                                </form>
                                <span class="qty-value">@item.Quantity</span>
                                <form method="post" asp-page-handler="UpdateQuantity" style="display:contents">
                                    <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="qty-btn">+</button>
                                </form>
                            </div>
                        </td>
                        <td class="cart-item-details">
                            <span class="cart-item-subtotal">R @item.Subtotal.ToString("N2")</span>
                        </td>
                        <td class="cart-item-details" style="text-align:center">
                            <form method="post" asp-page-handler="RemoveItem" style="display:contents">
                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <button type="submit" class="btn-remove" title="Remove item">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="cart-summary">
            <div class="cart-summary-row">
                <span class="cart-summary-label">Subtotal (@Model.CartItems.Sum(c => c.Quantity) items)</span>
                <span class="cart-summary-value">R @Model.CartTotal.ToString("N2")</span>
            </div>
            <div class="cart-summary-row total">
                <span class="cart-summary-label">Total</span>
                <span class="cart-summary-value">R @Model.CartTotal.ToString("N2")</span>
            </div>
            <a href="/Checkout" class="btn-checkout">
                <i class="fas fa-lock"></i> Proceed to Checkout
            </a>
        </div>
    }
</section>
