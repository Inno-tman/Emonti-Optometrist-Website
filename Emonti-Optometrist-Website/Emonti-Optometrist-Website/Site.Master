<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Emonti_Optometrist_Website.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Emonti Optometrist</title>
    
    <!-- Bootstrap CSS -->
    <link href="/Content/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Font Awesome - Multiple CDN sources for reliability -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.4.0/css/all.css" crossorigin="anonymous" />
    
    <!-- Add your custom Emonti styles -->
    <link href="/Content/EmontiStyles.css" rel="stylesheet" />
    
    <!-- Chatbot Styles -->
    <link href="/Content/ChatbotStyles.css" rel="stylesheet" />
    
    <style>
        /* Profile Dropdown Styles */
        .dropdown {
            position: relative;
            display: inline-block;
        }
        
        .dropdown-toggle {
            cursor: pointer;
        }
        
        .dropdown-menu {
            position: absolute;
            top: calc(100% + 0.75rem);
            left: 0;
            z-index: 1001;
            display: none;
            min-width: 220px;
            padding: 0.75rem 0;
            margin: 0;
            font-size: 0.9375rem;
            color: #212529;
            text-align: left;
            list-style: none;
            background-color: #ffffff;
            background-clip: padding-box;
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-radius: 12px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12), 0 4px 16px rgba(0, 0, 0, 0.08);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            overflow: hidden;
        }
        
        .dropdown-item {
            display: flex;
            align-items: center;
            width: 100%;
            padding: 0.75rem 1.25rem;
            clear: both;
            font-weight: 500;
            color: #2d2d2d;
            text-align: inherit;
            text-decoration: none;
            white-space: nowrap;
            background-color: transparent;
            border: 0;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
        }
        
        .dropdown-item:hover {
            color: #1a1a1a;
            background-color: rgba(44, 90, 160, 0.08);
        }
        
        .dropdown-item:active {
            background-color: rgba(44, 90, 160, 0.12);
        }
        
        .dropdown-item i {
            margin-right: 0.75rem;
            width: 18px;
            font-size: 0.875rem;
            color: rgba(45, 45, 45, 0.7);
            flex-shrink: 0;
            transition: color 0.2s ease;
        }
        
        .dropdown-item:hover i {
            color: #2c5aa0;
        }
        
        .dropdown-item[style*="color: #dc3545"],
        .dropdown-item.logout-item {
            color: #dc3545;
        }
        
        .dropdown-item[style*="color: #dc3545"]:hover,
        .dropdown-item.logout-item:hover {
            background-color: rgba(220, 53, 69, 0.1);
            color: #c82333 !important;
        }
        
        .dropdown-item[style*="color: #dc3545"]:hover i,
        .dropdown-item.logout-item:hover i {
            color: #c82333;
        }
        
        /* Divider styling */
        .dropdown-divider {
            height: 1px;
            margin: 0.5rem 0;
            background: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.1), transparent);
            border: none;
        }
        
        /* Ensure Font Awesome icons display properly */
        .fas, .far, .fab, .fal, .fad {
            font-family: "Font Awesome 6 Free", "FontAwesome", sans-serif;
            font-weight: 900;
            font-style: normal;
        }
        
        /* Immediate emoji fallbacks for key service icons */
        .fa-eye:before { content: "👁"; }
        .fa-eye-dropper:before { content: "💧"; }
        .fa-clipboard-check:before { content: "✓"; }

        /* Staff nav styling - small and aligned */
        .staff-nav { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; align-items: center; }
        .staff-nav li a { display: inline-block; padding: 0.5rem 0.75rem; border-radius: 12px; background: transparent; color: #333; text-decoration: none; }
        .staff-nav li a:hover { background: rgba(0,0,0,0.05); }
        
        /* User avatar circle (navbar button) */
        .user-avatar {
            display: inline-flex; align-items: center; justify-content: center;
            width: 28px; height: 28px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; font-size: 0.75rem; font-weight: 700;
            margin-right: 0.4rem; vertical-align: middle;
            flex-shrink: 0;
        }
        .auth-button.dropdown-toggle .user-avatar {
            display: inline-flex;
        }
        
        /* Dropdown header (user info) */
        .dropdown-header {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: linear-gradient(135deg, #f8f9ff, #f0f2ff);
            border-radius: 8px 8px 0 0;
        }
        .dropdown-user-avatar {
            display: flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; font-size: 1.1rem; font-weight: 700;
            flex-shrink: 0;
        }
        .dropdown-user-info {
            display: flex; flex-direction: column; min-width: 0;
        }
        .dropdown-user-name {
            font-weight: 600; font-size: 0.9rem; color: #333;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .dropdown-user-email {
            font-size: 0.75rem; color: #888;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        
        /* ===== Global form polish (ported from .NET 8) ===== */
        .form-group input:hover, .form-group select:hover, .form-group textarea:hover {
            border-color: #b0b8e0;
            background-color: #f8f9ff;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102,126,234,0.12);
            background-color: #fff;
        }
        
        /* Pill-shaped primary buttons */
        .btn-primary, input[type="submit"], .btn-login, .btn-register, .btn-save, .btn-book {
            border-radius: 50px !important;
        }
        
        /* ===== Scroll reveal animation (ported from .NET 8) ===== */
        .scroll-reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .scroll-reveal.active {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
    <script type="text/javascript">
        // Scroll reveal IntersectionObserver (ported from .NET 8)
        document.addEventListener('DOMContentLoaded', function() {
            var revealElements = document.querySelectorAll('.scroll-reveal');
            if (revealElements.length > 0 && 'IntersectionObserver' in window) {
                var observer = new IntersectionObserver(function(entries) {
                    entries.forEach(function(entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('active');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });
                revealElements.forEach(function(el) { observer.observe(el); });
            }
        });
    </script>
    
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <!-- Custom Header - Floating Pill Nav Bar (Stitch.money style) -->
        <header id="mainHeader" runat="server" class="header navbar-pill_component" role="banner">
            <div class="navbar-pill_container">
                <asp:HyperLink ID="logoLink" runat="server" NavigateUrl="~/Default.aspx" CssClass="navbar-pill_logo-link logo">
                    <span class="logo-brand">EMONTI</span>
                    <span class="logo-profession">OPTOMETRIST</span>
                </asp:HyperLink>
                <h1 id="logoText" runat="server" class="logo navbar-pill_logo-link" style="display:none; margin:0;">
                    <span class="logo-brand">EMONTI</span>
                    <span class="logo-profession">OPTOMETRIST</span>
                </h1>
                <nav class="navbar-pill_menu" role="navigation">
                    <div class="nav-menu-wrapper">
                        <div id="navPill" class="nav-pill-slider"></div>
                        <ul class="nav-menu" id="navMenu" runat="server">
                            <li><a href="~/Default.aspx" runat="server" id="navHome" class="nav-item"><i class="fas fa-home"></i> Home</a></li>
                            <li><a href="~/Services.aspx" runat="server" id="navServices" class="nav-item"><i class="fas fa-stethoscope"></i> Services</a></li>
                            <li><a href="~/Shop.aspx" runat="server" id="navShop" class="nav-item"><i class="fas fa-shopping-bag"></i> Shop</a></li>
                            <li><a href="~/AppointmentStart.aspx" runat="server" id="navAppointment" class="nav-item"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
                            <li><a href="~/About.aspx" runat="server" id="navAbout" class="nav-item"><i class="fas fa-info-circle"></i> About</a></li>
                            <li><a href="~/Contact.aspx" runat="server" id="navContact" class="nav-item"><i class="fas fa-phone"></i> Contact</a></li>
                            <li><a href="~/Help.aspx" runat="server" id="navHelp" class="nav-item"><i class="fas fa-question-circle"></i> Help</a></li>
                        </ul>
                    </div>
                </nav>

                <!-- Staff specific nav (visible only on staff pages when staff logged in) -->
                <ul class="staff-nav" id="staffNav" runat="server" style="display:none;">
                    <li><a href="~/Shop.aspx"><i class="fas fa-shopping-bag"></i> Shop</a></li>
                    <li><a href="~/AppointmentStart.aspx"><i class="fas fa-calendar-plus"></i> Book Appointment</a></li>
                    <li><a href="~/Reports.aspx"><i class="fas fa-chart-bar"></i> View Report</a></li>
                    <li id="adminDashboardLink" runat="server" visible="false"><a href="~/Admin/Dashboard.aspx"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
                    <li id="adminStaffLink" runat="server" visible="false"><a href="~/Admin/ManageStaff.aspx"><i class="fas fa-users-cog"></i> Staff</a></li>
                    <li id="adminCustomersLink" runat="server" visible="false"><a href="~/Admin/ManageCustomers.aspx"><i class="fas fa-user-friends"></i> Customers</a></li>
                    <li id="adminReportsLink" runat="server" visible="false"><a href="~/Reports.aspx"><i class="fas fa-chart-bar"></i> Reports</a></li>
                </ul>

                <div class="navbar-pill_menu-right">
                    <div class="nav-actions">
                        <asp:LinkButton ID="btnCart" runat="server" CssClass="cart-button" OnClick="btnCart_Click">
                            <i class="fas fa-shopping-cart"></i>
                            <span id="cartCountSpan" class="cart-count" runat="server">0</span>
                        </asp:LinkButton>
                        <!-- Login/Register buttons (shown when not logged in) -->
                        <asp:PlaceHolder ID="phAuth" runat="server">
                            <asp:LinkButton ID="btnLogin" runat="server" CssClass="auth-button" OnClick="btnLogin_Click" CausesValidation="false">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </asp:LinkButton>
                            <asp:LinkButton ID="btnRegister" runat="server" CssClass="auth-button" OnClick="btnRegister_Click" CausesValidation="false">
                                <i class="fas fa-user-plus"></i> Register
                            </asp:LinkButton>
                        </asp:PlaceHolder>
                        
                        <!-- My Account Dropdown (shown when logged in) -->
                        <div class="dropdown" style="position: relative; display: inline-block;">
                            <asp:LinkButton ID="btnMyAccount" runat="server" CssClass="auth-button dropdown-toggle" OnClientClick="toggleMyAccountDropdown(event); return false;" Visible="false">
                            </asp:LinkButton>
                            
                            <!-- Dropdown Menu -->
                            <div id="myAccountDropdown" class="dropdown-menu" style="display: none;">
                                <div class="dropdown-header" id="dropdownUserHeader">
                                    <span class="dropdown-user-avatar" id="dropdownUserAvatar"></span>
                                    <div class="dropdown-user-info">
                                        <span class="dropdown-user-name" id="dropdownUserName">My Account</span>
                                        <span class="dropdown-user-email" id="dropdownUserEmail"></span>
                                    </div>
                                </div>
                                <div class="dropdown-divider"></div>
                                <asp:LinkButton ID="btnPersonalDetails" runat="server" CssClass="dropdown-item" OnClick="btnPersonalDetails_Click">
                                    <i class="fas fa-user"></i> Personal Details
                                </asp:LinkButton>
                                <asp:LinkButton ID="btnOrders" runat="server" CssClass="dropdown-item" OnClick="btnOrders_Click">
                                    <i class="fas fa-shopping-bag"></i> Orders
                                </asp:LinkButton>
                                <asp:LinkButton ID="btnAppointments" runat="server" CssClass="dropdown-item" OnClick="btnAppointments_Click">
                                    <i class="fas fa-calendar"></i> Appointments
                                </asp:LinkButton>
                                <asp:LinkButton ID="btnWishlist" runat="server" CssClass="dropdown-item" OnClick="btnWishlist_Click">
                                    <i class="fas fa-heart"></i> Wishlist
                                </asp:LinkButton>
                                <div class="dropdown-divider"></div>
                                <asp:LinkButton ID="btnLogout" runat="server" CssClass="dropdown-item logout-item" OnClick="btnLogout_Click" CausesValidation="false" OnClientClick="if (typeof formChanged !== 'undefined') formChanged = false;">
                                    <i class="fas fa-sign-out-alt"></i> Logout
                                </asp:LinkButton>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mobile-menu-toggle" id="mobile-menu-toggle">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>

        <!-- Custom Footer -->
        <footer id="mainFooter" class="footer" runat="server">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>Contact Information</h3>
                    <p>📍 Shop 7 New Colonnade<br>Devereaux Ave, Vincent<br>East London 5247</p>
                    <p>📞 076 463 1930</p>
                    <p>✉️ emontioptom@gmail.com</p>
                </div>
                <div class="footer-section">
                    <h3>Quick Links</h3>
                    <ul>
                        <li><a href="~/Services.aspx" runat="server">Our Services</a></li>
                        <li><a href="~/Shop.aspx" runat="server">Shop Eyewear</a></li>
                        <li><a href="~/AppointmentStart.aspx" runat="server">Book Appointment</a></li>
                        <li><a href="~/About.aspx" runat="server">About Us</a></li>
                        <li><a href="~/Contact.aspx" runat="server">Contact</a></li>
                        <li><a href="~/Help.aspx" runat="server">Help & Support</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Services</h3>
                    <ul>
                        <li>Eye Examinations</li>
                        <li>Prescription Glasses</li>
                        <li>Contact Lenses</li>
                        <li>Medical Aid Claims</li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Opening Hours</h3>
                    <p>Monday - Friday: 8:00 AM - 5:00 PM<br>
                    Saturday: 8:00 AM - 2:00 PM<br>
                    Sunday: Closed</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; <%: DateTime.Now.Year %> Emonti Optometrist. All rights reserved.</p>
            </div>
        </footer>
    </form>

    <!-- Three.js Library for 3D Effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    
    <!-- jQuery and Bootstrap JavaScript -->
    <script src="/Scripts/jquery-3.7.0.min.js"></script>
    <script src="/Scripts/bootstrap.min.js"></script>
    
    <!-- Custom JavaScript -->
    <script src="/Scripts/EmontiScripts.js"></script>
    
    <!-- My Account Dropdown JavaScript -->
    <script>
        // Toggle dropdown without page refresh
        function toggleMyAccountDropdown(event) {
            event.preventDefault();
            event.stopPropagation();
            var dropdown = document.getElementById('myAccountDropdown');
            var myAccountBtn = document.getElementById('<%= btnMyAccount.ClientID %>');
            
            if (dropdown) {
                if (dropdown.style.display === 'none' || dropdown.style.display === '') {
                    dropdown.style.display = 'block';
                    dropdown.style.opacity = '1';
                    dropdown.style.visibility = 'visible';
                } else {
                    dropdown.style.display = 'none';
                }
            }
        }
        
        // Close dropdown when clicking outside
        document.addEventListener('click', function (event) {
            var dropdown = document.getElementById('myAccountDropdown');
            var myAccountBtn = document.getElementById('<%= btnMyAccount.ClientID %>');

            if (myAccountBtn && dropdown && !myAccountBtn.contains(event.target) && !dropdown.contains(event.target)) {
                dropdown.style.display = 'none';
            }
        });
        
        // Font Awesome debugging and fallback
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Checking Font Awesome loading...');
            
            setTimeout(function() {
                var icons = document.querySelectorAll('.fas, .far, .fab');
                console.log('Found ' + icons.length + ' Font Awesome icons');
                
                if (icons.length > 0) {
                    var testIcon = icons[0];
                    var computedStyle = window.getComputedStyle(testIcon, ':before');
                    var content = computedStyle.getPropertyValue('content');
                    var fontFamily = computedStyle.getPropertyValue('font-family');
                    
                    console.log('Test icon content:', content);
                    console.log('Test icon font-family:', fontFamily);
                    
                    var hasFontAwesome = content && content !== 'none' && content !== '""' && content !== '""';
                    
                    if (!hasFontAwesome) {
                        console.log('Font Awesome not working, applying emoji fallbacks');
                        var fallbackCSS = `
                            .fa-eye:before { content: "👁" !important; }
                            .fa-eye-dropper:before { content: "💧" !important; }
                            .fa-clipboard-check:before { content: "✓" !important; }
                            .fa-home:before { content: "🏠" !important; }
                            .fa-stethoscope:before { content: "🩺" !important; }
                            .fa-shopping-bag:before { content: "🛍" !important; }
                            .fa-calendar-plus:before { content: "📅" !important; }
                            .fa-info-circle:before { content: "ℹ" !important; }
                            .fa-phone:before { content: "📞" !important; }
                            .fa-question-circle:before { content: "❓" !important; }
                            .fa-shopping-cart:before { content: "🛒" !important; }
                            .fa-sign-in-alt:before { content: "🔑" !important; }
                            .fa-user-plus:before { content: "👤" !important; }
                            .fa-user-circle:before { content: "👤" !important; }
                            .fa-chevron-down:before { content: "▼" !important; }
                            .fa-user:before { content: "👤" !important; }
                            .fa-calendar:before { content: "📅" !important; }
                            .fa-heart:before { content: "❤" !important; }
                            .fa-sign-out-alt:before { content: "🚪" !important; }
                            .fa-user-md:before { content: "👨‍⚕️" !important; }
                        `;
                        var style = document.createElement('style');
                        style.textContent = fallbackCSS;
                        document.head.appendChild(style);
                    } else {
                        console.log('Font Awesome is working correctly');
                    }
                }
            }, 2000);
        });
    </script>
    
    <!-- FAQ Chatbot -->
    <div id="chatbot-container" class="chatbot-container" 
         data-enable-typing="1" 
         data-typing-delay="1000" 
         data-enable-suggestions="1" 
         data-enable-sound="0">
        <div id="chatbot-toggle" class="chatbot-toggle">
            <i class="fas fa-comments"></i>
            <span>FAQ Assistant</span>
        </div>
        <div id="chatbot-window" class="chatbot-window" style="display: none;">
            <div class="chatbot-header">
                <h5><i class="fas fa-robot"></i> FAQ Assistant</h5>
                <button id="chatbot-close" class="chatbot-close" aria-label="Close">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div id="chatbot-messages" class="chatbot-messages"></div>
            <div class="chatbot-input">
                <input type="text" id="chatbot-input" placeholder="Ask a question..." maxlength="500" />
                <button id="chatbot-send" class="chatbot-send" disabled>
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
    
    <!-- Chatbot Configuration -->
    <script src="/Scripts/ChatbotConfig.js"></script>
    
    <!-- Chatbot JavaScript -->
    <script src="/Scripts/Chatbot.js"></script>
</body>
</html></html>